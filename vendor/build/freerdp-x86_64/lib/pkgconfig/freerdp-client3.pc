prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include/freerdp3/
libs=-lfreerdp-client3

Name: FreeRDP client
Description: FreeRDP: A Remote Desktop Protocol Implementation
URL: https://freerdp.com/
Version: 3.33.0
Requires: freerdp3
Requires.private: cups freerdp3
Libs: -L${libdir} ${libs}
Libs.private: -lremdesk-common -lrdpsnd-common -ldl -lpthread
Cflags: -I${includedir}
